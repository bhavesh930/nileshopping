{
  "info": {
    "_postman_id": "nileshopping-api-collection",
    "name": "NileShopping API",
    "description": "JWT-authenticated mobile API for NileShopping (Laravel 12 + tymon/jwt-auth ^2.0).\n\n## Setup\n\n1. Set the collection variable `base_url` (default: `http://nileshopping.test`).\n2. Run **Auth → Signin** (or **Signin (Phone)**) — the response's `authorization.token` is captured automatically into `{{token}}` and used for every subsequent request.\n\nUnauthenticated endpoints: `signup`, `signin`, `login` (mobile phone-only). Everything else requires the JWT.\n\nGenerated from `routes/api.php` and `app/Http/Controllers/Api/`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://nileshopping.test",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"Jane\",\n  \"lastname\": \"Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"phone\": \"9999999999\",\n  \"gender\": \"female\",\n  \"dob\": \"1995-04-12\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "signup"
              ]
            },
            "description": "Create a new user.\n\n**Validation**\n- `name` required, string, between 2 and 100\n- `email` required, valid email, max 100, unique:users\n- `phone` required, string, unique:users\n- `gender` required, string, between 2 and 100\n\n**Optional**: `lastname`, `dob` (Y-m-d)\n\n**Note**: password is hard-coded server-side to `Nile@2021`."
          }
        },
        {
          "name": "Signin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const token = json?.authorization?.token || json?.access_token || json?.token;",
                  "  if (token) {",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('Saved token to collection variable.');",
                  "  } else {",
                  "    console.warn('No token field found in response — check the JSON shape.');",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"Nile@2021\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/signin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "signin"
              ]
            },
            "description": "Email + password login. On success, the test script captures the JWT from the response into the collection variable `{{token}}`.\n\n**Validation**\n- `email` required, valid email\n- `password` required, string, min 5"
          }
        },
        {
          "name": "Signin (Phone — Mobile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const token = json?.authorization?.token || json?.access_token || json?.token;",
                  "  if (token) pm.collectionVariables.set('token', token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"phone\": \"9999999999\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Phone-only login intended for the mobile app. Returns 404 if the phone isn't registered. Server uses the hard-coded password `Nile@2021` internally."
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user"
              ]
            },
            "description": "Returns the authenticated user."
          }
        },
        {
          "name": "Token Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const token = json?.authorization?.token || json?.access_token || json?.token;",
                  "  if (token) pm.collectionVariables.set('token', token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/token-refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token-refresh"
              ]
            },
            "description": "Refresh the JWT. Captures the new token into `{{token}}`."
          }
        },
        {
          "name": "Signout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/signout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "signout"
              ]
            },
            "description": "Invalidates the current JWT."
          }
        }
      ]
    },
